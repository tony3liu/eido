-                        message_id,
-                    },
-                    cx,
-                );
-            }
-
-            if undo {
-                assist.codegen.update(cx, |codegen, cx| codegen.undo(cx));
-            } else {
-                self.confirmed_assists.insert(assist_id, active_alternative);
-            }
-        }
-    }
