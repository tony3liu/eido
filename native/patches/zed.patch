+
+    fn eido_divider(&self, kind: u8, cx: &App) -> Stateful<Div> {
+        let weak = self.weak_self.clone();
+        div()
+            .id(("eido-divider", kind as usize))
+            .flex_none()
+            .flex()
+            .items_center()
+            .justify_center()
+            .bg(cx.theme().colors().editor_background)
+            .hover(|this| this.bg(cx.theme().colors().element_selected))
+            .child(
+                div()
+                    .bg(cx.theme().colors().border_variant)
+                    .when(kind == 2, |this| this.w_full().h(px(1.)))
+                    .when(kind != 2, |this| this.h_full().w(px(1.))),
+            )
+            .when(kind == 2, |this| {
+                this.h(px(5.)).w_full().cursor_row_resize()
+            })
+            .when(kind != 2, |this| {
+                this.w(px(5.)).h_full().cursor_col_resize()
+            })
+            .on_mouse_down(MouseButton::Left, move |event, window, cx| {
+                weak.update(cx, |workspace, _| {
+                    let initial = match kind {
+                        0 => workspace.eido_navigation_width,
+                        1 => {
+                            let available = (window.viewport_size().width
+                                - workspace.eido_navigation_width)
+                                .max(px(300.));
+                            workspace.eido_workbench_width.min(available * 0.52)
+                        }
+                        _ => {
+                            let workbench_visible = workspace.eido_layout != EidoLayout::Files
+                                && !workspace.eido_terminal_expanded;
+                            let reply_open = !workbench_visible && workspace.eido_reply_visible;
+                            workspace.eido_terminal_height.min(
+                                window.viewport_size().height * if reply_open { 0.2 } else { 0.35 },
+                            )
+                        }
+                    };
+                    workspace.eido_drag = Some((kind, event.position, initial));
+                })
+                .ok();
+                cx.stop_propagation();
+            })
+    }
+
+    pub fn set_eido_views(
+        &mut self,
+        embedded_panels: Vec<EntityId>,
+        navigation: AnyView,
+        workbench: AnyView,
+        composer: AnyView,
+        terminal: AnyView,
+        toolbar: AnyView,
+        cx: &mut Context<Self>,
+    ) {
+        self.eido_embedded_panels = embedded_panels;
+        self.eido_navigation = Some(navigation);
+        self.eido_workbench = Some(workbench);
+        self.eido_composer = Some(composer);
+        self.eido_terminal = Some(terminal);
+        self.eido_toolbar = Some(toolbar);
+        cx.notify();
+    }
+
+    pub fn eido_enabled(&self) -> bool {
+        self.eido_navigation.is_some()
+    }
+    pub fn eido_terminal_open(&self, cx: &App) -> bool {
+        self.eido_terminal_open
+            || (self.bottom_dock.read(cx).is_open()
+                && self
+                    .bottom_dock
+                    .read(cx)
+                    .active_panel()
+                    .is_some_and(|panel| {
+                        self.eido_terminal
+                            .as_ref()
+                            .is_some_and(|terminal| terminal.entity_id() == panel.panel_id())
+                    }))
+    }
+    pub fn eido_layout(&self) -> EidoLayout {
+        self.eido_layout
+    }
+    pub fn eido_toolbar(&self) -> Option<AnyView> {
+        self.eido_toolbar.clone()
+    }
+    pub fn eido_terminal_expanded(&self) -> bool {
+        self.eido_terminal_expanded
+    }
+    pub fn eido_reply_visible(&self) -> bool {
+        self.eido_reply_visible
+    }
+    pub fn set_eido_layout(&mut self, layout: EidoLayout, cx: &mut Context<Self>) {
+        self.eido_layout = layout;
+        self.eido_terminal_expanded = false;
+        cx.notify();
+    }
+    pub fn toggle_eido_workbench(&mut self, cx: &mut Context<Self>) {
+        let layout = if self.eido_layout == EidoLayout::Files {
+            EidoLayout::Split
+        } else {
+            EidoLayout::Files
+        };
+        self.set_eido_layout(layout, cx);
+    }
+    pub fn toggle_eido_terminal(&mut self, window: &mut Window, cx: &mut Context<Self>) {
+        self.eido_terminal_open = !self.eido_terminal_open(cx);
+        self.eido_terminal_expanded = false;
+        self.bottom_dock
+            .update(cx, |dock, cx| dock.set_open(false, window, cx));
+        cx.notify();
+    }
+    pub fn expand_eido_terminal(&mut self, cx: &mut Context<Self>) {
+        self.eido_terminal_open = true;
+        self.eido_terminal_expanded = !self.eido_terminal_expanded;
+        cx.notify();
+    }
+    pub fn toggle_eido_reply(&mut self, cx: &mut Context<Self>) {
+        self.eido_reply_visible = !self.eido_reply_visible;
+        cx.notify();
     }
 
