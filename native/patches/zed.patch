+#[derive(Default)]
+pub struct EidoAccess {
+    pub full_access: bool,
+    pub busy: bool,
+    pub error: Option<String>,
+}
+impl gpui::Global for EidoAccess {}
+
+fn full_access_enabled(content: &str) -> bool {
+    serde_json::from_str::<serde_json::Value>(content)
+        .ok()
+        .is_some_and(|settings| settings["eido"]["fullAccess"] == true)
+}
+
+fn global_full_access() -> bool {
+    let Some(root) = std::env::var_os("EIDO_ROOT") else { return false; };
+    // Global pi configuration only. Re-read each request so disabling the mode
+    // affects existing sessions without persisting per-tool Allow Always grants.
+    std::fs::read_to_string(PathBuf::from(root).join(".local/eido/settings.json"))
+        .ok()
+        .is_some_and(|content| full_access_enabled(&content))
+}
+
+#[test]
+fn test_eido_full_access_requires_explicit_global_boolean() {
+    assert!(full_access_enabled(r#"{"eido":{"fullAccess":true}}"#));
+    for value in ["{}", "invalid", r#"{"fullAccess":true}"#, r#"{"eido":{"fullAccess":"true"}}"#, r#"{"eido":{"fullAccess":false}}"#] {
+        assert!(!full_access_enabled(value));
+    }
+}
