+
+    /// Preview/status reads must not refresh the baseline authorizing an agent edit.
+    pub fn observe_text_file(
+        &self,
+        path: PathBuf,
+        cx: &mut Context<Self>,
+    ) -> Task<Result<String, acp::Error>> {
+        self.read_text_file_with_policy(path, None, None, false, false, cx)
+    }
+
+    fn read_text_file_with_policy(
+        &self,
+        path: PathBuf,
+        line: Option<u32>,
+        limit: Option<u32>,
+        reuse_shared_snapshot: bool,
+        record_read: bool,
+        cx: &mut Context<Self>,
