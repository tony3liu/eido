-    pub fn finish_assist(
-        &mut self,
-        assist_id: InlineAssistId,
-        undo: bool,
-        window: &mut Window,
-        cx: &mut App,
-    ) {
-        if let Some(assist) = self.assists.get(&assist_id) {
