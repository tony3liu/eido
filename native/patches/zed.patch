-fn sorted_pairs(map: &HashMap<String, String>) -> Vec<(String, String)> {
-    let mut pairs: Vec<(String, String)> = map
-        .iter()
-        .map(|(key, value)| (key.clone(), value.clone()))
-        .collect();
-    pairs.sort_by(|a, b| a.0.cmp(&b.0));
-    pairs
-}
