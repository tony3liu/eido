+#[derive(Debug, Clone, Serialize, Deserialize, agent_client_protocol::JsonRpcRequest)]
+#[request(method = "_eido/subagent/run", response = acp::PromptResponse)]
+#[serde(rename_all = "camelCase")]
+struct EidoSubagentRun {
+    parent_session_id: acp::SessionId,
+    child_session_id: acp::SessionId,
+    tool_call_id: acp::ToolCallId,
+    title: String,
+    task: String,
+}
+
+fn handle_eido_subagent_run(
+    request: EidoSubagentRun,
+    responder: Responder<acp::PromptResponse>,
+    cx: &mut AsyncApp,
+    ctx: &ClientContext,
+) {
+    let parent = ctx.sessions.borrow().get(&request.parent_session_id)
+        .and_then(|session| session.thread.upgrade());
+    let Some(parent) = parent else {
+        respond_err(responder, acp::Error::invalid_params().data("Unknown parent session"));
+        return;
+    };
+    let load = cx.update(|cx| {
+        let thread = parent.read(cx);
+        let valid = thread.tool_call_for_subagent(&request.child_session_id)
+            .is_some_and(|call| call.id == request.tool_call_id && matches!(call.status, acp_thread::ToolCallStatus::InProgress));
+        if !valid || request.task.trim().is_empty() {
+            return Err(acp::Error::invalid_params().data("Unregistered child delegation"));
+        }
+        let connection = thread.connection().clone();
+        let project = thread.project().clone();
+        let work_dirs = thread.work_dirs().cloned()
+            .unwrap_or_else(|| project.read(cx).default_path_list(cx));
+        Ok(connection.load_session(request.child_session_id.clone(), project, work_dirs, Some(request.title.into()), cx))
+    });
+    let load = match load {
+        Ok(load) => load,
+        Err(error) => { respond_err(responder, error); return; }
+    };
+    cx.spawn(async move |cx| {
+        let cancellation = responder.cancellation();
+        let mut running_child = None;
+        let result = cancellation.run_until_cancelled(async {
+            let child = load.await.map_err(acp::Error::from)?;
+            let still_active = parent.read_with(cx, |parent, _| {
+                parent.tool_call_for_subagent(&request.child_session_id)
+                    .is_some_and(|call| call.id == request.tool_call_id && matches!(call.status, acp_thread::ToolCallStatus::InProgress))
+            });
+            if !still_active {
+                return Err(acp::Error::invalid_params().data("Delegation is no longer active"));
+            }
+            parent.update(cx, |parent, cx| parent.subagent_spawned(request.child_session_id, cx));
+            // A normal AcpThread turn owns status, cancellation, permissions and
+            // native buffer/diff events. The host must register before prompting.
+            running_child = Some(child.clone());
+            let response = child.update(cx, |child, cx| child.send_delegated(vec![request.task.into()], cx)).await.map_err(acp::Error::from)?;
+            response.ok_or_else(|| acp::Error::internal_error().data("Child turn ended without a response"))
+        }).await;
+        if result.is_err() {
+            if let Some(child) = running_child {
+                child.update(cx, |child, cx| child.cancel(cx)).await;
+            }
+        }
+        respond_result(responder, result);
+    }).detach();
 }
 
