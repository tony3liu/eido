+fn request_permission_with_access_mode(
+    thread: &mut AcpThread,
+    args: acp::RequestPermissionRequest,
+    cx: &mut gpui::Context<AcpThread>,
+) -> Result<(Task<acp_thread::RequestPermissionOutcome>, Subscription)> {
+    let automatic = args.options.iter()
+        .find(|option| option.kind == acp::PermissionOptionKind::AllowOnce)
+        .map(|option| acp_thread::SelectedPermissionOutcome::new(option.option_id.clone(), option.kind));
+    let id = args.tool_call.tool_call_id.clone();
+    let task = thread.request_tool_call_authorization(
+        args.tool_call,
+        acp_thread::PermissionOptions::Flat(args.options),
+        acp_thread::AuthorizationKind::PermissionGrant,
+        cx,
+    )?;
+    // A successful global switch to Full Access also releases a
+    // permission request already waiting in this conversation.
+    let subscription = cx.observe_global::<EidoAccess>(move |thread, cx| {
+        if cx.try_global::<EidoAccess>().is_some_and(|state| state.full_access && !state.busy)
+            && thread.tool_call(&id).is_some_and(|(_, call)| matches!(call.status, acp_thread::ToolCallStatus::WaitingForConfirmation { .. }))
+        {
+            if let Some(outcome) = &automatic {
+                thread.authorize_tool_call(id.clone(), outcome.clone(), cx);
+            }
+        }
+    });
+    Ok((task, subscription))
+}
