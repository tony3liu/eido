-                "Assistant output does not match expected output: {:?}",
-                o
-            )),
-            o @ InlineAssistantOutput::Malformed { .. } => EvalOutput::failed(format!(
-                "Assistant output does not match expected output: {:?}",
-                o
-            )),
-        }
-    }
